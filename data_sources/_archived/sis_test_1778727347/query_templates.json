{
  "student_lookup": {
    "description": "Look up registration records by approved student identifiers.",
    "tables": [
      "dbo.REG",
      "dbo.REG_BUILDING"
    ],
    "params": [
      "student_id",
      "campus_id",
      "current_status"
    ],
    "required_any": [
      [
        "student_id"
      ]
    ],
    "max_rows": 25,
    "result_shape": "student_records",
    "redaction_profile": "student_default"
  },
  "campus_enrollment_summary": {
    "description": "Summarize registration counts for a campus and school year.",
    "tables": [
      "dbo.REG",
      "dbo.REG_BUILDING"
    ],
    "params": [
      "campus_id",
      "grade_level",
      "current_status"
    ],
    "required_all": [
      "campus_id"
    ],
    "max_rows": 50,
    "result_shape": "summary_rows",
    "redaction_profile": "summary_only"
  },
  "program_membership_lookup": {
    "description": "Summarize or inspect student program memberships using approved keys.",
    "tables": [
      "dbo.REG_PROGRAMS",
      "dbo.REG"
    ],
    "params": [
      "student_id",
      "campus_id",
      "program_id",
      "program_value",
      "active_only"
    ],
    "required_any": [
      [
        "student_id"
      ],
      [
        "program_id",
        "campus_id"
      ]
    ],
    "max_rows": 50,
    "result_shape": "program_rows",
    "redaction_profile": "student_default"
  },
  "schema_inventory": {
    "description": "Read SQL Server metadata for tables and columns by schema/table pattern. Use this to verify the live SIS table and column inventory in chunks such as REG_%, SCHD_%, or TX_%.",
    "tables": [
      "sys.tables",
      "sys.schemas",
      "sys.columns",
      "sys.types",
      "sys.default_constraints",
      "sys.indexes",
      "sys.index_columns"
    ],
    "params": [
      "schema_like",
      "table_like"
    ],
    "max_rows": 500,
    "result_shape": "schema_inventory_rows",
    "redaction_profile": "metadata_only"
  }
}
