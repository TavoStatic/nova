{
  "connection_health": {
    "description": "Show saved Ed-Fi capability profile and connection health for this district connection.",
    "resources": [],
    "params": [],
    "max_rows": 1,
    "result_shape": "health_summary",
    "redaction_profile": "none"
  },
  "list_schools": {
    "description": "List campuses for one LEA. Use full_lea=true to collect all matching schools (dynamic district size).",
    "resources": ["ed-fi/schools"],
    "params": ["offset", "district_lea_id", "lea_id", "full_lea", "collect_all"],
    "max_rows": 2000,
    "result_shape": "edfi_records",
    "redaction_profile": "education_org_default"
  },
  "list_students": {
    "description": "List students from the ODS (district-scoped client filter). Page-sized reads only — use extracts for bulk.",
    "resources": ["ed-fi/students"],
    "params": ["offset", "district_lea_id", "lea_id"],
    "max_rows": 100,
    "result_shape": "edfi_records",
    "redaction_profile": "student_default"
  },
  "student_school_associations": {
    "description": "List student-school associations (district-scoped client filter).",
    "resources": ["ed-fi/studentSchoolAssociations"],
    "params": ["offset", "district_lea_id", "lea_id"],
    "max_rows": 200,
    "result_shape": "edfi_records",
    "redaction_profile": "student_default"
  },
  "list_resources": {
    "description": "Browse discovered Ed-Fi resource names from the saved capability profile.",
    "resources": ["metadata"],
    "params": ["query", "namespace", "offset"],
    "max_rows": 50,
    "result_shape": "resource_names",
    "redaction_profile": "none"
  },
  "sync_status": {
    "description": "Show ODS change-version window and saved per-resource sync cursors.",
    "resources": ["changeQueries"],
    "params": [],
    "max_rows": 1,
    "result_shape": "sync_summary",
    "redaction_profile": "none"
  },
  "changes_since": {
    "description": "Pull district-scoped records changed since a change version or saved cursor.",
    "resources": ["ed-fi/schools", "ed-fi/students", "ed-fi/studentSchoolAssociations"],
    "params": ["resource", "min_change_version", "offset", "advance_cursor", "district_lea_id", "lea_id"],
    "max_rows": 25,
    "result_shape": "edfi_records",
    "redaction_profile": "resource_aware"
  }
}
